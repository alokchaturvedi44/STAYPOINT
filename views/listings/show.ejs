<% layout("./layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3> <%= listing.title %> </h3> <br>
    </div>
    <div class="card col-6 offset-2 show-card listing-card">
        <img src="<%= listing.image %>" class="card-img-top show-image" alt="listing_image"> <br><br> 
        <div class="card-body col-6">
            <p class="card-text">
                <i><%= listing.owner.username %></i> <br>
                <%= listing.description %>  <br>
                &#8377; <%= new Intl.NumberFormat("en-IN").format(listing.price) %> / night  <br>
                <%= listing.location %>  <br>
                <%= listing.country %>  
            </p>
        </div>
        
        <br>
        
        <div class="d-flex justify-content-between">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn">Edit</a>
            
            <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark add-btn">Delete</button>
            </form>
        </div>
    </div>
    
    <div class="col-8 offset-2 mb-3">
        <hr>
        <h4>Leave a Review! </h4>
        <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mt-3 mb-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
            </div>
            <div class="mt-3 mb-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]" id="comment" cols="20" rows="4" class="form-control" required ></textarea>
                <div class="invalid-feedback">Please add sum comments for review</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>
        <p><b>All Reviews</b></p>
        <div class="row">
            <% for(review of listing.reviews) { %>
                <div class="card col-5 ms-3 mb-2">
                    <div class="card-body">
                        <h5 class="card-title">Alok Chaturvedi</h5>
                        <p class="card-text"><%= review.comment %></p>
                        <p class="card-text"><%= review.rating %> &#127775;</p>
                        <form class="mb-2 mt-1" method="post" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button> 
                        </form>
                    </div>
                </div>
            <% } %>
        </div>
    </div> 


</div>
